# ─────────────────────────────────────────────────────────────
# GrowthOS — Environment Variables (Phase 1)
# Copy to `.env` for local dev. Never commit real secrets.
# All values are validated at startup by src/config/env.ts (Zod).
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
# When running the app on the host against docker-compose, host is localhost.
# Inside the docker network, host is `postgres`.
DATABASE_URL=postgresql://growthos:growthos@localhost:5432/growthos?schema=public
# Separate privileged URL used ONLY by migrations (bypasses RLS).
DATABASE_MIGRATION_URL=postgresql://growthos:growthos@localhost:5432/growthos?schema=public

# ── Auth.js (NextAuth v5) ────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000
# Trust the host header behind the Coolify proxy in production.
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Redis (cache + BullMQ) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant (vector DB) ───────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── PostHog (analytics) ──────────────────────────────────────
# Server key (capture from Node) + public key (browser).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_SERVER_KEY=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="GrowthOS <noreply@growthos.app>"

# ── OpenRouter (AI) — present for config validation; AI is Phase 2+ ──
OPENROUTER_API_KEY=
